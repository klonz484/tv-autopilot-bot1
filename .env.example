# TradingView credentials (optional but recommended for full symbol access)
TV_USERNAME=your_tradingview_username
TV_PASSWORD=your_tradingview_password

# Exchange API (for live trading - use testnet / demo first!)
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_PASSWORD=          # passphrase if required (e.g. OKX, KuCoin)
EXCHANGE_TESTNET=true

# Webhook security
WEBHOOK_KEY=change_this_to_a_long_random_string

# Risk
RISK_PER_TRADE=0.01         # 1% of equity
MAX_POSITIONS=3
